# Chép thành .env.local (máy dev) hoặc đặt trong môi trường của server. Không commit file có giá trị thật.

# --- Đăng nhập Google Workspace (Auth.js) ---
# Chuỗi ngẫu nhiên ≥ 32 ký tự để mã hoá cookie phiên: npx auth secret  (hoặc: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=
# OAuth Client "Web application" tạo trên Google Cloud Console (consent screen: Internal)
# Redirect URI: https://<tên-miền>/api/auth/callback/google  (dev: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# URL gốc của website khi chạy sau reverse proxy, VD https://docs.mkvision.local
AUTH_URL=
# Tên miền email được phép (mặc định mkvision.com)
AUTH_ALLOWED_DOMAIN=mkvision.com
# Chỉ để chạy thử trên máy: 1 = bỏ qua đăng nhập. KHÔNG đặt trên server thật.
AUTH_DISABLED=

# --- Tồn kho (Google Sheet) ---
# ID trong link https://docs.google.com/spreadsheets/d/<ID>/edit  — file phải là Google Sheet (không phải .xlsx tải lên)
INVENTORY_SHEET_ID=
# Vùng đọc; mặc định A1:Z5000 của sheet đầu tiên. VD: TonKho!A1:D5000
INVENTORY_SHEET_RANGE=
# Service account (Google Cloud → IAM → Service accounts, bật Google Sheets API + Google Drive API).
# Chia sẻ Sheet cho email service account quyền Viewer. Dùng một trong hai:
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Ngưỡng "Sắp hết" (mặc định 10) và chu kỳ kiểm tra file (giây, mặc định 60, tối thiểu 15)
INVENTORY_LOW_STOCK=10
INVENTORY_POLL_SECONDS=60
# Chạy thử không cần Google: đường dẫn file CSV cùng định dạng (templates/ton-kho-mau.csv)
INVENTORY_LOCAL_FILE=
