# Chép thành .env.local (máy dev) hoặc đặt trong môi trường của server. Không commit file có giá trị thật.

# --- Đăng nhập Google Workspace (Auth.js) ---
# Chuỗi ngẫu nhiên ≥ 32 ký tự để mã hoá cookie phiên: npx auth secret  (hoặc: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=
# OAuth Client "Web application" tạo trên Google Cloud Console (consent screen: Internal)
# Redirect URI: https://<tên-miền>/api/auth/callback/google  (dev: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# URL gốc của website khi chạy sau reverse proxy, VD https://docs.mkvision.local
AUTH_URL=
# Tên miền email được phép (mặc định mkvision.com)
AUTH_ALLOWED_DOMAIN=mkvision.com
# Chỉ để chạy thử trên máy: 1 = bỏ qua đăng nhập. KHÔNG đặt trên server thật.
AUTH_DISABLED=
